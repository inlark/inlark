---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import Keyboard from '../components/Keyboard.astro'
import Features from '../components/Features.astro'
import Reliability from '../components/Reliability.astro'
import Setup from '../components/Setup.astro'
import Privacy from '../components/Privacy.astro'
import InstallSection from '../components/InstallSection.astro'
import Closing from '../components/Closing.astro'
---

<Layout
  title="Inlark — beautiful email for Linux"
  description="A fast, keyboard-first email client for your own JMAP and IMAP accounts. Unified inbox, no hosted service, no telemetry. Free software for Linux."
>
  <Nav />
  <main>
    <Hero />
    <Keyboard />
    <Features />
    <Reliability />
    <Setup />
    <Privacy />
    <InstallSection />
  </main>
  <Closing />
</Layout>
