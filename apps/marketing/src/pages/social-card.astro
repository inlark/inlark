---
/* The source of public/social-card.png, the preview image link unfurls show. It is a page so the
   card uses the site's own fonts, mark, and inbox. After changing it, run `pnpm social-card`. */
import '@fontsource-variable/hanken-grotesk'
import '@fontsource-variable/inter'
import '../styles/global.css'
import { Mark } from '../components/Mark'
import { Wordmark } from '@inlark/ui/components/wordmark'
import InboxWindow from '../components/InboxWindow.astro'
---

<!doctype html>
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>inlark social card</title>
  </head>
  <body>
    <div class="social">
      <div class="brand">
        <Mark size={34} />
        <Wordmark height={25} decorative />
      </div>
      <h1 class="display">
        Beautiful email.
        <br />
        <span>For everyone.</span>
      </h1>

      <div class="dawn"></div>
      <div class="window @container">
        <InboxWindow theme="dark" />
      </div>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #08080a;
  }

  .social {
    position: relative;
    isolation: isolate;
    width: 1200px;
    height: 630px;
    padding: 0 68px;
    overflow: hidden;
    background: #08080a;
    color: var(--color-ink);
    font-family: var(--font-sans);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    padding-top: 56px;
  }

  h1 {
    margin-top: 44px;
    font-size: 92px;
  }
  h1 span {
    color: var(--color-ink-3);
  }

  /* The card is a still, so the light is already up. */
  .dawn {
    --dawn-x: 60%;
    top: 0;
    z-index: -1;
    width: 1200px;
    height: 440px;
  }
  .dawn::before,
  .dawn::after {
    animation: none;
  }

  /* The window rises out of the bottom edge, as it does in the hero. */
  .window {
    position: absolute;
    left: 68px;
    top: 396px;
    width: 1064px;
    height: 620px;
    border-radius: 16px;
    padding: 1px;
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.22),
      rgb(255 255 255 / 0.07) 22%,
      rgb(255 255 255 / 0.04)
    );
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.6),
      0 50px 140px -30px #000;
  }
  .window::before {
    content: '';
    position: absolute;
    inset: 0 10% auto;
    height: 1px;
    z-index: 3;
    background: linear-gradient(90deg, transparent, rgb(255 230 212 / 0.75), transparent);
  }
  .window :global(.app),
  .window :global(.app-shell) {
    height: 100%;
    border-radius: 15px;
    overflow: hidden;
  }
</style>
