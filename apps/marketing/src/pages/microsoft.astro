---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { links } from '../data/links'
import { approveUrl, clientId, permissions } from '../data/microsoft'

const facts = [
  { label: 'Application (client) ID', value: clientId, mono: true },
  { label: 'Name shown by Microsoft', value: 'inlark' },
  {
    label: 'Kind of app',
    value: 'Desktop app for Linux, Windows and macOS. A public client: it holds no secret.',
  },
  {
    label: 'Kind of access',
    value:
      'Delegated only. inlark acts as the person who signed in, in their own mailbox, and has no access of its own to your organization.',
  },
  { label: 'Source code', value: 'github.com/inlark/inlark', href: links.repo },
  { label: 'Operator', value: 'Paul Köck, Feldkirch, Austria', href: links.imprint },
]
const promises = [
  {
    title: 'Mail stays between the computer and Microsoft',
    text: 'inlark connects from the person’s computer straight to Microsoft’s servers. There is no inlark server in between, and no copy of anyone’s mail anywhere else.',
  },
  {
    title: 'Sign-in happens on Microsoft’s page',
    text: 'People sign in in their own browser, on Microsoft’s site, with whatever your organization requires: multi-factor, passkeys, conditional access. inlark never sees a password.',
  },
  {
    title: 'The sign-in stays on that computer',
    text: 'What Microsoft hands back is stored in the operating system’s keyring. On a computer without one, the person chooses whether inlark remembers it, in an unencrypted file only their own user account can read. Removing the account from inlark, or revoking the app in Entra, ends it.',
  },
  {
    title: 'No telemetry',
    text: 'inlark sends no usage data and has no analytics. Its source is public under the AGPL, so every claim on this page can be checked.',
  },
]
---

<Layout
  title="Approve inlark for Microsoft 365 — inlark"
  description="What inlark asks Microsoft for, why an administrator has to approve it, and where to do that."
>
  <meta slot="head" name="robots" content="noindex" />
  <Nav page="microsoft" />
  <main class="wrap pt-32 pb-28 sm:pt-44 sm:pb-40">
    <!-- Filled in by the script below when Microsoft sends an administrator back here. -->
    <div
      id="consent-result"
      class="rise mb-12 hidden rounded-xl border border-line-strong bg-night-2 px-5 py-4"
      role="status"
    >
      <p id="consent-title" class="title"></p>
      <p id="consent-text" class="copy mt-1.5 text-[0.9375rem]"></p>
    </div>

    <header class="rise max-w-3xl">
      <h1 class="display">Approve inlark for your organization</h1>
      <p class="lede mt-7">
        inlark is an open-source email app for the desktop. Someone in your organization wants to
        read their Microsoft 365 mail with it, and Microsoft asks an administrator to approve that
        first. This page says what you would be approving.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href={approveUrl} class="btn btn-primary" rel="noreferrer">
          Review and approve at Microsoft
        </a>
        <a href="#permissions" class="link text-[0.9375rem]">
          What it asks for
        </a>
      </div>
      <p class="copy mt-5 max-w-xl text-[0.875rem] text-ink-3">
        The button opens Microsoft’s own consent page. You sign in there as an administrator, see
        the same list of permissions, and decide. Nothing is approved by visiting this page.
      </p>
    </header>

    <section class="rise mt-20 sm:mt-28" style="--delay:.06s" aria-labelledby="why">
      <div class="grid gap-x-16 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="why" class="statement text-[clamp(1.5rem,2.6vw,2rem)]">
            Why Microsoft asks you
          </h2>
        </div>
        <div class="copy grid gap-4 lg:col-span-7">
          <p>
            Microsoft’s default for organizations lets people approve most apps themselves, but not
            an app that reads mail over IMAP. Only a handful of mail apps that Microsoft lists by
            name are exempt. For every other one, inlark included, an administrator approves once
            and everyone in the organization can then sign in.
          </p>
          <p>
            Microsoft shows inlark as “unverified”. That label is about Microsoft’s partner
            programme, which inlark’s publisher has not joined; it says nothing about what the app
            does. The details below are what to go by.
          </p>
        </div>
      </div>
    </section>

    <section class="rise mt-20 sm:mt-28" style="--delay:.1s" aria-labelledby="permissions">
      <h2 id="permissions" class="statement scroll-mt-28 text-[clamp(1.5rem,2.6vw,2rem)]">
        What inlark asks for
      </h2>
      <p class="copy mt-4 max-w-2xl">
        Five delegated permissions. Each one works only for the person who signed in and only in
        their own mailbox. inlark asks for no application permissions and nothing that reaches other
        people’s mail, files, calendars or your directory.
      </p>
      <div class="mt-9 border-b border-line">
        {permissions.map((p) => (
          <div class="grid gap-x-10 gap-y-1.5 border-t border-line py-5 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <code class="font-mono text-[0.875rem] text-ink">{p.name}</code>
              <p class="mt-1 text-[0.8125rem] text-ink-3">Microsoft calls it “{p.microsoft}”</p>
            </div>
            <p class="copy lg:col-span-8">{p.use}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="rise mt-20 sm:mt-28" style="--delay:.12s" aria-labelledby="handling">
      <h2 id="handling" class="statement text-[clamp(1.5rem,2.6vw,2rem)]">
        What happens to the mail
      </h2>
      <div class="mt-9 grid gap-x-12 gap-y-9 sm:grid-cols-2">
        {promises.map((p) => (
          <div class="border-t border-line pt-5">
            <h3 class="title">{p.title}</h3>
            <p class="copy mt-2">{p.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="rise mt-20 sm:mt-28" style="--delay:.14s" aria-labelledby="details">
      <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 id="details" class="statement text-[clamp(1.5rem,2.6vw,2rem)]">
            The registration
          </h2>
          <dl class="mt-9 border-b border-line text-[0.9375rem]">
            {facts.map((f) => (
              <div class="grid gap-1 border-t border-line py-3.5 sm:grid-cols-[13rem_1fr] sm:gap-6">
                <dt class="text-ink-3">{f.label}</dt>
                <dd class:list={['text-ink-2', f.mono && 'font-mono text-[0.875rem] break-all']}>
                  {f.href ? (
                    <a href={f.href} class="link text-ink">
                      {f.value}
                    </a>
                  ) : (
                    f.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="lg:col-span-5">
          <section class="border-t border-line pt-5 pb-9">
            <h3 class="title">Two mailbox settings matter too</h3>
            <p class="copy mt-3 text-[0.9375rem] leading-[1.7]">
              IMAP has to be enabled for the mailbox in Exchange Online, or inlark can sign in but
              not read mail. SMTP AUTH is optional: where it is disabled, inlark sends through
              Microsoft Graph, which limits a message to about 3 MB.
            </p>
          </section>
          <section class="border-t border-line pt-5 pb-9">
            <h3 class="title">Taking the approval back</h3>
            <p class="copy mt-3 text-[0.9375rem] leading-[1.7]">
              In the Microsoft Entra admin center, open Enterprise applications, find inlark by the
              ID above and delete it or remove its permissions. Everyone’s sign-in then stops
              working until it is approved again.
            </p>
          </section>
          <section class="border-t border-line pt-5">
            <h3 class="title">Not an administrator?</h3>
            <p class="copy mt-3 text-[0.9375rem] leading-[1.7]">
              Send this page to whoever looks after Microsoft 365 where you work. Personal
              Outlook.com, Hotmail, Live and MSN accounts need no approval at all:
              <a href={links.download} class="link">
                download inlark
              </a>{' '}
              and sign in.
            </p>
          </section>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline>
  // Microsoft returns here with the outcome in the address. It is shown, then removed from the
  // address bar and history; nothing about it leaves this page.
  ;(() => {
    const answer = new URLSearchParams(location.search)
    const approved = answer.get('admin_consent')
    const error = answer.get('error')
    if (!approved && !error) return
    const title = document.getElementById('consent-title')
    const text = document.getElementById('consent-text')
    if (/^true$/i.test(approved || '') && !error) {
      title.textContent = 'inlark is approved for your organization'
      text.textContent =
        'People there can now choose Sign in with Microsoft in inlark. Nothing else is needed from you.'
    } else if (
      // Microsoft's words for an administrator choosing Cancel on its page.
      error === 'access_denied' ||
      error === 'consent_required' ||
      /AADSTS65004\b/.test(answer.get('error_description') || '')
    ) {
      title.textContent = 'Nothing was approved'
      text.textContent =
        'Microsoft reports that the request was declined or closed. You can review it again with the button below.'
    } else {
      title.textContent = 'Microsoft couldn’t complete the approval'
      text.textContent =
        'Nothing was changed. Try again with the button below, signed in as an administrator of the organization.'
    }
    document.getElementById('consent-result').classList.remove('hidden')
    history.replaceState(null, '', location.pathname)
  })()
</script>
