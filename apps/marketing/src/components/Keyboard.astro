---
import { KeyboardDemo } from './KeyboardDemo'
---

<section id="keyboard" class="wrap mt-28 sm:mt-44">
  <header class="reveal border-t border-line pt-12 sm:pt-16">
    <h2 class="statement">
      Your hands never leave the keys.{' '}
      <span>Each everyday action is a single keystroke, from triage to reply.</span>
    </h2>
    <p class="copy mt-6 max-w-md">
      This inbox is live. Try it with your keyboard, or click the keys.
    </p>
  </header>
  <div class="reveal mt-12 sm:mt-16" style="--delay:.08s">
    <KeyboardDemo client:visible />
  </div>
</section>
