---
import { Check } from '@inlark/ui/icons'

const found = [
  {
    label: 'Server · JMAP',
    value: 'mail.fernstudio.design',
    note: 'Found in the domain’s DNS records',
  },
  { label: 'Security', value: 'TLS · certificate verified', note: 'No plaintext fallback, ever' },
]

const points = [
  {
    title: 'Checked before it’s saved',
    text: 'Incoming and outgoing servers are signed in to separately, and the account is only saved when both work.',
  },
  {
    title: 'Your password stays put',
    text: 'Discovery never carries credentials, and saved logins go into your OS keyring when one is available.',
  },
]
---

<section id="setup" class="wrap mt-28 sm:mt-44">
  <header class="reveal border-t border-line pt-12 sm:pt-16">
    <h2 class="statement">
      Type your address. inlark finds the rest,{' '}
      <span>and shows exactly what it found before it asks for a password.</span>
    </h2>
  </header>

  <div class="mt-14 grid items-start gap-x-16 gap-y-14 sm:mt-20 lg:grid-cols-12">
    <div class="reveal order-2 lg:order-1 lg:col-span-5" aria-hidden="true">
      <div class="app">
        <div class="frame max-w-md">
          <div class="rounded-[15px] bg-(--bg) p-6 sm:p-7">
            <p class="text-[16px] font-semibold text-(--text-strong)">Connect an account</p>
            <p class="mt-1 text-[12px] text-(--muted)">
              inlark connects straight to your mail server.
            </p>

            <p class="mt-5 text-[12px] text-(--secondary)">Email address</p>
            <div class="mt-1.5 rounded-[6px] border border-(--border-strong) bg-(--surface) px-3 py-2 text-[13px] text-(--text-strong)">
              <span class="typed">sam@fernstudio.design</span>
            </div>

            <div class="mt-4 rounded-[10px] border border-(--border) bg-(--surface) p-1">
              <p class="px-3 pt-2 pb-1.5 text-[11px] text-(--muted)">
                Settings for fernstudio.design
              </p>
              {found.map((row, i) => (
                <div
                  class="found flex items-center gap-3 rounded-[7px] px-3 py-2.5"
                  style={`--i:${i}`}
                >
                  <span class="grid size-5 shrink-0 place-items-center rounded-full bg-(--green)/15 text-(--green)">
                    <Check size={11} strokeWidth={2.4} />
                  </span>
                  <div class="min-w-0">
                    <p class="text-[11px] text-(--muted)">{row.label}</p>
                    <p class="truncate text-[13px] text-(--text-strong)">{row.value}</p>
                  </div>
                  <span class="ml-auto hidden max-w-[8.25rem] shrink-0 text-right text-[10.5px] leading-snug text-(--faint) sm:block">
                    {row.note}
                  </span>
                </div>
              ))}
            </div>

            <p class="mt-4 text-[12px] text-(--secondary)">Password</p>
            <div class="mt-1.5 rounded-[6px] border border-(--accent-solid) bg-(--surface) px-3 py-2 text-[13px] tracking-[0.2em] text-(--text-strong)">
              ••••••••••••
            </div>
            <p class="mt-3 flex items-center gap-2 text-[12px] text-(--secondary)">
              <span class="grid size-4 place-items-center rounded-[4px] bg-(--accent-solid) text-white">
                <Check size={10} strokeWidth={2.6} />
              </span>
              Remember this login in the OS keyring
            </p>
            <div class="mt-5 flex items-center justify-between">
              <span class="text-[12px] text-(--muted)">Set up manually</span>
              <span class="rounded-[6px] bg-(--accent-solid) px-3.5 py-1.5 text-[12px] font-medium text-white">
                Connect account
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="reveal order-1 lg:order-2 lg:col-span-6 lg:col-start-7" style="--delay:.08s">
      <p class="copy">
        inlark reads the settings your domain publishes: JMAP first, then IMAP and SMTP. Setting up
        by hand is always there if you prefer it.
      </p>
      <dl class="mt-8 border-b border-line">
        {points.map((p) => (
          <div class="border-t border-line py-6">
            <dt class="title">{p.title}</dt>
            <dd class="copy mt-2">{p.text}</dd>
          </div>
        ))}
      </dl>
      <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[0.72rem] text-ink-3">
        {['JMAP', 'IMAP', 'SMTP', 'TLS', 'STARTTLS', 'Self-hosted'].map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    border-right: 1.5px solid transparent;
    width: 0;
  }
  :global(.is-visible) .typed {
    animation:
      type 1.1s steps(21) 0.35s forwards,
      caret 0.9s steps(1) 0.35s 2;
  }
  @keyframes type {
    to {
      width: 21ch;
    }
  }
  @keyframes caret {
    0% {
      border-color: var(--accent);
    }
    50% {
      border-color: transparent;
    }
  }
  .found {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.6s var(--ease-out-expo),
      transform 0.6s var(--ease-out-expo);
    transition-delay: calc(1.6s + var(--i) * 0.35s);
  }
  :global(.is-visible) .found {
    opacity: 1;
    transform: none;
  }
  @media (scripting: none) {
    .typed {
      width: auto;
    }
    .found {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .typed {
      width: auto;
    }
  }
</style>
