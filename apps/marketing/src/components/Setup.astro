---
import { Check, LockKeyhole } from '@inlark/ui/icons'

const found = [
  {
    label: 'Server · JMAP',
    value: 'mail.fernstudio.design',
    note: 'Found in the domain’s DNS records',
  },
  { label: 'Security', value: 'TLS · certificate verified', note: 'No plaintext fallback, ever' },
]
---

<section id="setup" class="relative mx-auto max-w-6xl px-5 pt-32 sm:px-8 sm:pt-44">
  <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_1fr] lg:gap-20">
    <div class="reveal relative order-2 lg:order-1" aria-hidden="true">
      <div class="setup-glow"></div>
      <div class="app relative" data-theme="dark">
        <div class="mx-auto max-w-md rounded-[16px] border border-(--border-strong) bg-(--bg) p-6 shadow-[0_40px_100px_-30px_#000] sm:p-7">
          <p class="text-[16px] font-semibold text-(--text-strong)">Connect an account</p>
          <p class="mt-1 text-[12px] text-(--muted)">
            Inlark connects straight to your mail server.
          </p>

          <label class="mt-5 block text-[12px] text-(--secondary)">Email address</label>
          <div class="mt-1.5 rounded-[6px] border border-(--border-strong) bg-white/[0.03] px-3 py-2 text-[13px] text-(--text-strong)">
            <span class="typed">sam@fernstudio.design</span>
          </div>

          <div class="mt-4 rounded-[10px] border border-(--border) bg-(--surface) p-1">
            <p class="px-3 pt-2 pb-1.5 text-[11px] text-(--muted)">
              Settings for fernstudio.design
            </p>
            {found.map((row, i) => (
              <div
                class="found flex items-center gap-3 rounded-[7px] px-3 py-2.5"
                style={`--i:${i}`}
              >
                <span class="check grid size-5 shrink-0 place-items-center rounded-full bg-(--green)/15 text-(--green)">
                  <Check size={11} strokeWidth={2.4} />
                </span>
                <div class="min-w-0">
                  <p class="text-[11px] text-(--muted)">{row.label}</p>
                  <p class="truncate text-[13px] text-(--text-strong)">{row.value}</p>
                </div>
                <span class="ml-auto hidden text-right text-[10.5px] text-(--faint) sm:block">
                  {row.note}
                </span>
              </div>
            ))}
          </div>

          <label class="mt-4 block text-[12px] text-(--secondary)">Password</label>
          <div class="mt-1.5 rounded-[6px] border border-(--accent-solid) bg-white/[0.03] px-3 py-2 text-[13px] tracking-[0.2em] text-(--text-strong)">
            ••••••••••••
          </div>
          <p class="mt-3 flex items-center gap-2 text-[12px] text-(--secondary)">
            <span class="grid size-4 place-items-center rounded-[4px] bg-(--accent-solid) text-white">
              <Check size={10} strokeWidth={2.6} />
            </span>
            Remember this login in the OS keyring
          </p>
          <div class="mt-5 flex items-center justify-between">
            <span class="text-[12px] text-(--muted)">Set up manually</span>
            <span class="rounded-[6px] bg-(--accent-solid) px-3.5 py-1.5 text-[12px] font-medium text-white">
              Connect account
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="reveal order-1 lg:order-2" style="--delay:.08s">
      <p class="eyebrow">Two-minute setup</p>
      <h2 class="display mt-5 text-[clamp(2.4rem,5.4vw,4.2rem)]">
        Type your address. Inlark finds the rest.
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-ink-2">
        Inlark reads the settings your domain publishes — JMAP first, then IMAP and SMTP — and shows
        exactly what it found before it asks for a password.
      </p>
      <ul class="mt-8 flex flex-col gap-5 text-ink-2">
        <li class="flex gap-3.5">
          <Check size={18} className="mt-0.5 shrink-0 text-leaf" />
          <span>
            <span class="font-semibold text-ink">Checked before it’s saved.</span> Incoming and
            outgoing servers are signed in to separately, and the account is only saved when both
            work.
          </span>
        </li>
        <li class="flex gap-3.5">
          <LockKeyhole size={18} className="mt-0.5 shrink-0 text-lavender" />
          <span>
            <span class="font-semibold text-ink">Your password stays put.</span> Discovery never
            carries credentials, and saved logins live in your desktop keyring.
          </span>
        </li>
      </ul>
      <div class="mt-9 flex flex-wrap gap-2 font-mono text-[0.72rem] text-ink-2">
        {['JMAP', 'IMAP', 'SMTP', 'TLS', 'STARTTLS', 'Self-hosted'].map((p) => (
          <span class="rounded-md border border-line-strong bg-white/[0.02] px-2.5 py-1">{p}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .setup-glow {
    position: absolute;
    inset: 0 5%;
    background: radial-gradient(closest-side, rgb(242 184 139 / 0.13), transparent);
    filter: blur(40px);
  }
  .typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    border-right: 1.5px solid transparent;
    width: 0;
  }
  :global(.is-visible) .typed {
    animation:
      type 1.1s steps(21) 0.35s forwards,
      caret 0.9s steps(1) 0.35s 2;
  }
  @keyframes type {
    to {
      width: 21ch;
    }
  }
  @keyframes caret {
    0% {
      border-color: var(--accent);
    }
    50% {
      border-color: transparent;
    }
  }
  .found {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.6s var(--ease-out-expo),
      transform 0.6s var(--ease-out-expo),
      background-color 1.2s;
    transition-delay: calc(1.6s + var(--i) * 0.35s);
  }
  :global(.is-visible) .found {
    opacity: 1;
    transform: none;
  }
  @media (scripting: none) {
    .typed {
      width: auto;
    }
    .found {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .typed {
      width: auto;
    }
  }
</style>
