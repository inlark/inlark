---
import {
  Archive,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  ChevronUp,
  Download,
  FileImage,
  Forward,
  Mail,
  MoreHorizontal,
  Reply,
  ReplyAll,
  Star,
  Trash2,
} from '@inlark/ui/icons'
import AppSidebar from './AppSidebar.astro'
import { AccountMark, SenderTile } from './mail/MailRow'
import { accountById, inbox } from '../data/mail'

interface Props {
  /** Pins a theme; otherwise the window follows the page. */
  theme?: 'dark' | 'light'
}

const { theme } = Astro.props
const conversation = inbox.find((c) => c.id === 'priya')!
const account = accountById[conversation.account]
const attachments = [
  { icon: FileImage, name: 'ridge-sunrise.jpg', detail: 'JPG · 3.1 MB' },
  { icon: FileImage, name: 'summit.jpg', detail: 'JPG · 2.4 MB' },
]
---

<div class="app" data-theme={theme} aria-hidden="true">
  <div class="app-shell h-full">
    <AppSidebar />

    <main class="app-main">
      <header class="flex h-[52px] shrink-0 items-center gap-4 border-b border-(--border) px-5 text-(--muted)">
        <span class="flex items-center gap-1.5 text-[12.5px] text-(--secondary)">
          <ChevronLeft size={15} /> Inbox
        </span>
        <span class="h-4 w-px bg-(--border-strong)"></span>
        <Archive size={16} />
        <Trash2 size={16} />
        <Mail size={16} className="@max-[480px]:hidden" />
        <Star size={16} />
        <MoreHorizontal size={16} className="@max-[480px]:hidden" />
        <span class="ml-auto flex items-center gap-3.5 text-[11.5px] whitespace-nowrap">
          3 of 140
          <ChevronUp size={15} />
          <ChevronDown size={15} />
        </span>
      </header>

      <article class="mx-auto w-full max-w-[640px] flex-1 overflow-hidden px-8 pt-7 @max-[480px]:px-5">
        <div class="flex items-center gap-2 text-[11.5px] text-(--muted)">
          <AccountMark account={account} size={14} />
          <span class="text-(--secondary)">{account.name}</span>
          <ChevronRight size={11} className="text-(--faint)" /> Conversation
        </div>
        <h3 class="mt-3 text-[23px] leading-tight font-semibold tracking-[-0.02em] text-(--text-strong)">
          {conversation.subject}
        </h3>

        <div class="mt-5 flex items-center gap-3 border-t border-(--border-strong) pt-5">
          <span class="reader-tile">
            <SenderTile name={conversation.sender} tint={conversation.tint} />
          </span>
          <div class="min-w-0 text-[12.5px] leading-snug">
            <p class="truncate">
              <span class="font-semibold text-(--text-strong)">{conversation.sender}</span>
              <span class="ml-2 text-[11.5px] text-(--muted) @max-[480px]:hidden">
                priya@nair.example
              </span>
            </p>
            <p class="text-[11.5px] text-(--muted)">to Sam</p>
          </div>
          <span class="ml-auto shrink-0 text-[11.5px] text-(--muted)">
            Today · {conversation.time}
          </span>
        </div>

        <div class="mt-5 flex flex-col gap-2.5 pl-[46px] text-[14px] leading-[1.7] text-(--text)">
          {conversation.body?.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="mt-5 flex flex-wrap gap-2.5 pl-[46px]">
          {attachments.map(({ icon: Icon, name, detail }) => (
            <span class="flex items-center gap-2.5 rounded-[8px] border border-(--border-strong) p-[9px] pr-3">
              <span class="grid size-[34px] place-items-center rounded-[7px] bg-(--accent)/8 text-(--accent)">
                <Icon size={17} />
              </span>
              <span class="text-[12px] leading-snug">
                <strong class="block font-semibold text-(--text-strong)">{name}</strong>
                <span class="block text-[11px] text-(--muted)">{detail}</span>
              </span>
              <Download size={14} className="ml-1.5 text-(--muted)" />
            </span>
          ))}
        </div>

        <div class="mt-6 ml-[46px] rounded-[10px] border border-(--border-strong) bg-(--surface)/60 px-4 py-3.5 text-[12.5px]">
          <p class="flex items-center gap-3 font-medium text-(--text-strong)">
            <Reply size={16} className="text-(--secondary)" /> Reply to {conversation.sender}
            <span class="app-kbd ml-auto">R</span>
          </p>
          <p class="mt-3.5 flex items-center gap-6 pl-7 text-[11.5px] text-(--secondary)">
            <span class="flex items-center gap-2">
              <ReplyAll size={14} /> Reply all <span class="app-kbd">A</span>
            </span>
            <span class="flex items-center gap-2">
              <Forward size={14} /> Forward <span class="app-kbd">F</span>
            </span>
          </p>
        </div>
      </article>
    </main>
  </div>
</div>

<style>
  .reader-tile :global(.sender-tile) {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    font-size: 12px;
  }
</style>
