---
import { Mark } from './Mark'
import { Wordmark } from '@inlark/ui/components/wordmark'
import { links } from '../data/links'

const footer = [
  { href: links.repo, label: 'Source' },
  { href: links.releases, label: 'Releases' },
  { href: links.issues, label: 'Issues' },
  { href: links.license, label: 'License' },
  { href: links.imprint, label: 'Imprint' },
]
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 text-sm text-ink-3 sm:flex-row sm:items-center sm:px-8">
    <div class="flex items-center gap-1.5">
      <Mark size={18} />
      <Wordmark height={14} className="text-ink-2" />
      <span class="ml-2">© 2026 Paul Koeck · AGPL-3.0</span>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 sm:ml-auto" aria-label="Project">
      {footer.map((l) => (
        <a href={l.href} class="transition-colors hover:text-ink">
          {l.label}
        </a>
      ))}
    </nav>
  </div>
  <p class="mx-auto max-w-6xl px-5 pb-10 text-xs text-ink-3 sm:px-8">
    This site sets no cookies, loads nothing from other servers and counts no visitors.
  </p>
</footer>
