---
import { Mark } from './Mark'
import { Wordmark } from '@inlark/ui/components/wordmark'
import { links } from '../data/links'

interface Props {
  /** Leaves out the top rule where the section above already ends on the horizon. */
  horizon?: boolean
}

const { horizon = false } = Astro.props
const footer = [
  { href: links.download, label: 'Download' },
  { href: links.repo, label: 'Source' },
  { href: links.releases, label: 'Releases' },
  { href: links.issues, label: 'Issues' },
  { href: links.license, label: 'License' },
  { href: links.imprint, label: 'Imprint' },
]
---

<footer class:list={[!horizon && 'border-t border-line']}>
  <div class="wrap flex flex-col gap-x-10 gap-y-6 pt-10 pb-6 text-[0.875rem] text-ink-3 sm:flex-row sm:items-center">
    <a href="/" class="flex items-center gap-1.5" aria-label="inlark home">
      <Mark size={18} />
      <Wordmark height={14} className="text-ink" decorative />
    </a>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 sm:ml-auto" aria-label="Project">
      {footer.map((l) => (
        <a href={l.href} class="transition-colors hover:text-ink">
          {l.label}
        </a>
      ))}
    </nav>
  </div>
  <div class="wrap flex flex-col gap-2 pb-10 text-[0.8125rem] text-ink-3 sm:flex-row sm:justify-between">
    <p>© 2026 Paul Koeck · AGPL-3.0</p>
    <p>This site sets no cookies, loads nothing from other servers and counts no visitors.</p>
  </div>
</footer>
