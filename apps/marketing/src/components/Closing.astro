---
import { Download } from '@inlark/ui/icons'
import DownloadLabel from './DownloadLabel.astro'
import { GitHubIcon } from './GitHubIcon'
import { links } from '../data/links'
import Footer from './Footer.astro'
---

<section class="closing relative isolate mt-28 overflow-hidden sm:mt-44">
  <div class="dawn closing-dawn" aria-hidden="true"></div>
  <div class="wrap reveal relative pt-28 pb-56 text-center sm:pt-40 sm:pb-72">
    <h2 class="display">
      Good morning,
      <br />
      <span class="text-ink-3">inbox.</span>
    </h2>
    <p class="lede mx-auto mt-7 max-w-[30rem] text-balance">
      Calm, fast, dependable email for Linux, Windows and macOS. Free and open source, from the
      first line to the last.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={links.download} class="btn btn-primary">
        <Download size={17} />
        <DownloadLabel />
      </a>
      <a href={links.repo} class="btn btn-ghost">
        <GitHubIcon className="size-4" /> Star on GitHub
      </a>
    </div>
    <p class="mt-9 text-[0.9375rem] text-balance text-ink-3">
      Made by one person. If you’d like to say thanks, you can{' '}
      <a href={links.support} class="link">
        buy me a coffee
      </a>
      .
    </p>
  </div>
</section>

<Footer horizon />

<style>
  /* The day the page has been leading up to: the sun clears the horizon the footer stands on. */
  .closing {
    view-timeline-name: --closing;
  }
  .closing-dawn {
    bottom: 0;
    height: min(34rem, 100%);
  }
  .closing-dawn::before {
    width: min(2000px, 220vw);
  }
  /* Where the browser can tie it to scrolling, the sun comes up as the section does. */
  @supports (animation-timeline: view()) {
    .closing-dawn::before {
      animation: sun-up linear both;
      animation-timeline: --closing;
      animation-range: entry 10% cover 55%;
    }
    .closing-dawn::after {
      animation: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .closing-dawn::before {
      animation: none;
    }
  }
  @keyframes sun-up {
    from {
      opacity: 0.15;
      transform: scale(0.75, 0.3);
    }
  }
</style>
