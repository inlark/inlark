---
import { ArrowUpRight, Download } from '@inlark/ui/icons'
import DownloadLabel from './DownloadLabel.astro'
import InboxWindow from './InboxWindow.astro'
import { GitHubIcon } from './GitHubIcon'
import { links } from '../data/links'
import { fetchLatestRelease, unconfirmedRelease } from '../data/release'

const release = import.meta.env.PROD
  ? ((await fetchLatestRelease(import.meta.env.GITHUB_TOKEN).catch(() => null)) ??
    unconfirmedRelease)
  : unconfirmedRelease

const facts = [
  { label: 'Platforms', value: 'Linux, Windows and macOS' },
  { label: 'Protocols', value: 'JMAP, IMAP and SMTP' },
  { label: 'Privacy', value: 'No account, no cloud, no telemetry' },
  { label: 'License', value: 'Free software, AGPL-3.0' },
]
---

<section id="top" class="relative isolate overflow-x-clip pt-32 sm:pt-44">
  <div class="wrap relative z-10">
    <h1 class="display rise">
      Beautiful email.
      <br />
      <span class="text-ink-3">For everyone.</span>
    </h1>

    <p class="lede rise mt-7 max-w-[35rem] sm:mt-8" style="--delay:.07s">
      inlark is a fast, keyboard-first mail client for the accounts you already own. Every JMAP and
      IMAP inbox in one calm place, with no hosted service in between and no telemetry.
    </p>

    <div class="rise mt-9 flex flex-wrap items-center gap-3" style="--delay:.14s">
      <a href={links.download} class="btn btn-primary">
        <Download size={17} />
        <DownloadLabel />
      </a>
      <a href={links.repo} class="btn btn-ghost">
        <GitHubIcon className="size-4" /> View source
      </a>
    </div>

    <p class="rise mt-6 text-[0.8125rem] text-ink-3" style="--delay:.2s">
      <a href={links.releases} class="group inline-flex items-center gap-1 hover:text-ink-2">
        <span class="font-mono text-[0.75rem] text-lavender" data-release-version>
          v{release.version}
        </span>
        <span class="ml-1">early preview</span>
        <ArrowUpRight
          size={13}
          className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </p>
  </div>

  <div class="stage wrap relative mt-16 sm:mt-24">
    <div class="dawn hero-dawn" aria-hidden="true"></div>
    <div class="window @container">
      <InboxWindow animate />
    </div>
    <p class="sr-only">
      inlark’s unified inbox, showing conversations from four accounts in one list, each marked with
      the colour of its account.
    </p>
  </div>

  <div class="wrap relative z-10">
    <dl class="facts mt-16 grid grid-cols-2 border-t border-line sm:mt-24 lg:grid-cols-4">
      {facts.map((fact) => (
        <div class="fact py-5 pr-6 lg:py-6">
          <dt class="text-[0.8125rem] text-ink-3">{fact.label}</dt>
          <dd class="mt-1 text-[0.9375rem] font-medium text-ink">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  import { fetchCurrentRelease } from '../data/release'

  const badge = document.querySelector('[data-release-version]')
  if (badge) {
    void fetchCurrentRelease().then((release) => {
      if (release) badge.textContent = `v${release.version}`
    })
  }
</script>

<style>
  .stage {
    --window-height: clamp(400px, 52vw, 672px);
  }

  /* The horizon crosses just behind the window's top edge, so the window comes up with the light. */
  .hero-dawn {
    top: -400px;
    height: calc(400px + 4.5rem);
  }
  /* The light swells for a moment as the new message lands in the inbox. */
  .hero-dawn::before {
    animation:
      dawn-rise 2.8s var(--ease-out-expo) 0.1s both,
      arrival-light 2.4s ease-out 2.7s;
  }
  @keyframes arrival-light {
    25% {
      filter: brightness(1.4);
    }
  }

  .window {
    position: relative;
    z-index: 2;
    height: var(--window-height);
    border-radius: 16px;
    padding: 1px;
    background: linear-gradient(
      180deg,
      light-dark(rgb(20 20 30 / 0.14), rgb(255 255 255 / 0.22)),
      light-dark(rgb(20 20 30 / 0.07), rgb(255 255 255 / 0.07)) 22%,
      light-dark(rgb(20 20 30 / 0.05), rgb(255 255 255 / 0.04))
    );
    box-shadow:
      0 0 0 1px light-dark(rgb(20 20 30 / 0.03), rgb(0 0 0 / 0.6)),
      0 60px 120px -40px light-dark(rgb(22 24 36 / 0.3), #000),
      0 24px 50px -24px light-dark(rgb(22 24 36 / 0.16), rgb(0 0 0 / 0.8));
    transform-origin: 50% 0;
    animation: window-in 1.6s var(--ease-out-expo) 0.25s both;
  }
  /* The top edge catches the light behind it. */
  .window::before {
    content: '';
    position: absolute;
    inset: 0 10% auto;
    height: 1px;
    z-index: 3;
    background: linear-gradient(
      90deg,
      transparent,
      light-dark(rgb(255 255 255 / 0.9), rgb(226 224 255 / 0.7)),
      transparent
    );
  }
  .window :global(.app) {
    height: 100%;
    border-radius: 15px;
    overflow: hidden;
  }
  .window :global(.app-shell) {
    border-radius: 15px;
  }

  .fact + .fact {
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-line);
  }
  @media (width < 64rem) {
    .fact + .fact:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .fact:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }
  }
</style>
