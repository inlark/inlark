---
import { AlertCircle, FileText, Mail, Send } from '@inlark/ui/icons'
import { AccountMark } from './mail/MailRow'
import { accountById } from '../data/mail'

const points = [
  {
    title: 'Drafts that outlast anything',
    text: 'Every draft is saved on your device as you write, then synced to your server. Quitting, crashing or losing the connection won’t take your words with it.',
  },
  {
    title: 'Sending you can trust',
    text: 'Each message says exactly where it stands. If the connection drops mid-send, inlark marks it unconfirmed and never sends it again on its own.',
  },
  {
    title: 'Partial delivery, handled',
    text: 'When a server refuses some recipients, you see exactly who, with a new draft ready for just them.',
  },
  {
    title: 'Honest about your server',
    text: 'If a server can’t move or delete a message safely, inlark turns that action off and tells you why, instead of guessing.',
  },
]
---

<section id="reliability" class="wrap mt-28 sm:mt-44">
  <header class="reveal border-t border-line pt-12 sm:pt-16">
    <h2 class="statement">
      Nothing you write gets lost.{' '}
      <span>Drafts are saved as you type, and every send says exactly where it stands.</span>
    </h2>
  </header>

  <div class="mt-14 grid items-start gap-x-16 gap-y-14 sm:mt-20 lg:grid-cols-12">
    <dl class="reveal border-b border-line lg:col-span-5">
      {points.map((p) => (
        <div class="border-t border-line py-6">
          <dt class="title">{p.title}</dt>
          <dd class="copy mt-2">{p.text}</dd>
        </div>
      ))}
    </dl>

    <div class="reveal relative lg:col-span-7" style="--delay:.1s" aria-hidden="true">
      <div class="app relative">
        <div class="frame">
          <div class="app-main !rounded-[15px] !border-0">
            <header class="flex items-center gap-2.5 px-6 pt-5 pb-1">
              <span class="text-[17px] font-semibold tracking-[-0.01em] text-(--text-strong)">
                Send status
              </span>
              <span class="rounded-[5px] border border-(--border-strong) px-1.5 py-px text-[10.5px] text-(--muted)">
                3
              </span>
            </header>
            <p class="px-6 pt-4 pb-2 text-[11px] font-medium text-(--faint)">Needs attention</p>

            <div class="status-item border-b border-(--border) px-6 py-4" style="--i:0">
              <div class="flex items-center gap-3">
                <Mail size={16} className="shrink-0 text-(--muted)" />
                <span class="text-[13px] font-medium text-(--text-strong)">
                  Re: Coffee sometime next week?
                </span>
                <span class="ml-auto text-[11px] text-(--muted)">9:02 AM</span>
              </div>
              <p class="mt-1.5 flex items-center gap-2 pl-7 text-[12px] text-(--green)">
                Sent · Copy in Sent pending
                <span class="flex items-center gap-1.5 text-[11.5px] text-(--muted)">
                  <AccountMark account={accountById.personal} size={12} /> Personal
                </span>
              </p>
              <p class="mt-1 pl-7 text-[11.5px] text-(--muted)">
                Delivered. Its copy in Sent hasn’t been saved yet.
              </p>
            </div>

            <div class="status-item border-b border-(--border) px-6 py-4" style="--i:1">
              <div class="flex items-center gap-3">
                <AlertCircle size={16} className="shrink-0 text-(--muted)" />
                <span class="text-[13px] font-medium text-(--text-strong)">Quarterly numbers</span>
                <span class="ml-auto text-[11px] text-(--muted)">8:51 AM</span>
              </div>
              <p class="mt-1.5 flex items-center gap-2 pl-7 text-[12px] text-(--star)">
                Delivery unconfirmed
                <span class="flex items-center gap-1.5 text-[11.5px] text-(--muted)">
                  <AccountMark account={accountById.studio} size={12} /> Studio
                </span>
              </p>
              <p class="mt-1 max-w-md pl-7 text-[11.5px] leading-relaxed text-(--muted)">
                The server may have accepted this message. Check again before sending a replacement,
                or recipients may get it twice.
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-2 pl-7 text-[11.5px]">
                <span class="rounded-[6px] border border-(--border-strong) bg-(--surface) px-2.5 py-1 text-(--text-strong)">
                  Check again
                </span>
                <span class="rounded-[6px] border border-(--border-strong) bg-(--surface) px-2.5 py-1 text-(--text-strong)">
                  Send a replacement…
                </span>
                <span class="px-2 text-(--secondary)">Dismiss</span>
              </div>
            </div>

            <div class="status-item px-6 pt-4 pb-9" style="--i:2">
              <div class="flex items-center gap-3">
                <Send size={16} className="shrink-0 text-(--muted)" />
                <span class="text-[13px] font-medium text-(--text-strong)">
                  Plans for the offsite
                </span>
                <span class="ml-auto text-[11px] text-(--muted)">8:14 AM</span>
              </div>
              <p class="mt-1.5 flex items-center gap-2 pl-7 text-[12px] text-(--accent)">
                Partially sent
                <span class="flex items-center gap-1.5 text-[11.5px] text-(--muted)">
                  <AccountMark account={accountById.studio} size={12} /> Studio
                </span>
              </p>
              <p class="mt-1 pl-7 text-[11.5px] text-(--muted)">
                Not delivered to <span class="text-(--secondary)">kai@oldmail.example</span>.
                Everyone else received it.
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-2 pl-7 text-[11.5px]">
                <span class="flex items-center gap-1.5 rounded-[6px] border border-(--border-strong) bg-(--surface) px-2.5 py-1 text-(--text-strong)">
                  <FileText size={12} /> Create draft to refused recipients
                </span>
                <span class="px-2 text-(--secondary)">Dismiss</span>
              </div>
            </div>
          </div>
        </div>

        <div class="draft-chip absolute -bottom-4 left-5 flex items-center gap-2 rounded-[9px] border border-(--border-strong) bg-(--raised) px-3 py-2 text-[11.5px] text-(--secondary) shadow-[0_18px_50px_var(--shadow)] sm:left-8">
          <span class="size-1.5 rounded-full bg-(--green)"></span> Draft saved on this device
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .status-item {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.8s var(--ease-out-expo),
      transform 0.8s var(--ease-out-expo);
    transition-delay: calc(0.25s + var(--i) * 0.14s);
  }
  :global(.is-visible) .status-item {
    opacity: 1;
    transform: none;
  }
  .draft-chip {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.8s var(--ease-out-expo) 0.8s,
      transform 0.8s var(--ease-out-expo) 0.8s;
  }
  :global(.is-visible) .draft-chip {
    opacity: 1;
    transform: none;
  }
  @media (scripting: none) {
    .status-item,
    .draft-chip {
      opacity: 1;
      transform: none;
    }
  }
</style>
