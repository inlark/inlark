---
import { LockKeyhole, ShieldCheck, UserRound, WifiOff } from '@inlark/ui/icons'
import { AppTile } from './download/icons'

const principles = [
  {
    icon: UserRound,
    title: 'No account, no middleman',
    text: 'There’s nothing to sign up for. inlark talks to your JMAP or IMAP and SMTP server directly.',
  },
  {
    icon: WifiOff,
    title: 'No telemetry',
    text: 'No analytics, no tracking, no usage reports. What happens in your inbox stays on your machine.',
  },
  {
    icon: ShieldCheck,
    title: 'Encryption, verified',
    text: 'Implicit TLS or required STARTTLS, always with certificate checks and never a plaintext fallback.',
  },
  {
    icon: LockKeyhole,
    title: 'Passwords in your OS keyring',
    text: 'Remembered passwords go into your system’s keyring. Without one, inlark asks first: session only, or an unencrypted file only your account can read.',
  },
]
---

<section id="privacy" class="wrap mt-28 sm:mt-44">
  <header class="reveal border-t border-line pt-12 sm:pt-16">
    <h2 class="statement">
      Between you and your server.{' '}
      <span>No account to create, no cloud in the middle, no telemetry.</span>
    </h2>
  </header>

  <!-- The route a message takes: one direct, encrypted line. The detour through someone else's
       service is drawn as the path not taken. -->
  <div class="route reveal mt-14 sm:mt-20" style="--delay:.08s" aria-hidden="true">
    <div class="node">
      <AppTile size={56} />
      <p class="mt-4 text-[0.9375rem] font-semibold text-ink">inlark</p>
      <p class="text-[0.8125rem] text-ink-3">on your desktop</p>
    </div>

    <div class="between">
      <svg class="detour" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0 100C22 -33 78 -33 100 100" vector-effect="non-scaling-stroke"></path>
      </svg>
      <div class="ghost">
        <span class="ghost-node">
          <svg
            viewBox="0 0 24 24"
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              d="M7 18h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.1 9.2 4.5 4.5 0 0 0 7 18Z"
              stroke-linejoin="round"
            ></path>
          </svg>
        </span>
        <p class="mt-2.5 text-[0.8125rem] text-ink-3">
          <s>inlark cloud</s>
          <span class="max-sm:hidden"> · there isn’t one</span>
        </p>
      </div>

      <div class="wire">
        <span class="pulse"></span>
        <span class="pulse pulse-back"></span>
      </div>
      <span class="lock">
        <LockKeyhole size={13} />
      </span>
      <p class="tls text-[0.8125rem] text-ink-2">
        TLS<span class="max-sm:hidden">, certificate verified</span>
      </p>
    </div>

    <div class="node">
      <span class="grid size-14 place-items-center rounded-2xl border border-line-strong bg-night-2 text-ink-2">
        <svg
          viewBox="0 0 24 24"
          class="size-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <rect x="3.5" y="4" width="17" height="7" rx="2"></rect>
          <rect x="3.5" y="13" width="17" height="7" rx="2"></rect>
          <path d="M7.5 7.5h.01M7.5 16.5h.01" stroke-width="2.2" stroke-linecap="round"></path>
        </svg>
      </span>
      <p class="mt-4 text-[0.9375rem] font-semibold text-ink">Your server</p>
      <p class="text-[0.8125rem] text-ink-3">
        <span class="max-sm:hidden">mail.</span>yourdomain.com
      </p>
    </div>
  </div>

  <div class="ledger mt-16 sm:mt-24">
    <div class="ledger-row sm:max-lg:grid-cols-2">
      {principles.map(({ icon: Icon, title, text }, i) => (
        <div class="cell principle reveal lg:col-span-3" style={`--delay:${i * 0.06}s`}>
          <Icon size={18} className="text-lavender" />
          <h3 class="title mt-5">{title}</h3>
          <p class="copy mt-2">{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .route {
    --rise: 5.5rem;
    display: flex;
    align-items: flex-start;
    gap: clamp(0.75rem, 3vw, 2rem);
    /* Room above the line for the detour and the cloud at its top. */
    padding-top: calc(var(--rise) - 28px + 1.5rem);
  }
  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 8.5rem;
    flex-shrink: 0;
  }
  @media (max-width: 480px) {
    .node {
      width: 6.5rem;
    }
  }

  /* The space between the two ends. The line runs at the height of their icons' centres. */
  .between {
    position: relative;
    flex: 1;
    height: 56px;
  }
  .wire {
    position: absolute;
    inset: 28px 0 auto;
    height: 1px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-lavender) 45%, transparent);
  }
  /* Mail on its way: a brighter stretch of the line itself, travelling each way in turn. */
  .pulse {
    position: absolute;
    inset: 0 auto 0 0;
    width: 7rem;
    background: linear-gradient(90deg, transparent, light-dark(#3d379f, #f1f0ff), transparent);
    animation: pulse-out 6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  .pulse-back {
    animation-name: pulse-back;
    animation-delay: 3s;
  }
  @keyframes pulse-out {
    0% {
      left: -7rem;
    }
    45%,
    100% {
      left: 100%;
    }
  }
  @keyframes pulse-back {
    0% {
      left: 100%;
    }
    45%,
    100% {
      left: -7rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      display: none;
    }
  }

  .lock {
    position: absolute;
    left: 50%;
    top: 28px;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    translate: -50% -50%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-lavender) 45%, transparent);
    color: var(--color-lavender);
    background: var(--color-night);
  }
  .tls {
    position: absolute;
    inset: calc(28px + 1.4rem) 0 auto;
    text-align: center;
    white-space: nowrap;
  }

  /* The path not taken: up to a service in the middle and back down, in dashes. */
  .detour {
    position: absolute;
    inset: auto 0 28px;
    width: 100%;
    height: var(--rise);
    overflow: visible;
  }
  .detour path {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }
  .ghost {
    position: absolute;
    left: 50%;
    bottom: calc(28px + var(--rise));
    display: flex;
    flex-direction: column;
    align-items: center;
    translate: -50% calc(100% - 1.125rem);
    white-space: nowrap;
  }
  .ghost-node {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.7rem;
    border: 1px dashed var(--color-line-strong);
    color: var(--color-ink-3);
    background: var(--color-night);
  }

  /* Four across on wide screens, two on tablets, one on phones; the rules follow. */
  @media (width >= 40rem) and (width < 64rem) {
    .principle {
      padding-inline: 0 2rem;
    }
    .principle:nth-child(even) {
      padding-inline: 2rem 0;
      border-left: 1px solid var(--color-line);
    }
    .principle:nth-child(2) {
      border-top: 0;
    }
  }
</style>
