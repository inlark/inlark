---
import {
  Archive,
  Check,
  ChevronDown,
  ChevronUp,
  CornerDownLeft,
  Inbox,
  Moon,
  Search,
  Sun,
  Undo2,
  X,
} from '@inlark/ui/icons'
import { Mark } from './Mark'
import ReaderWindow from './ReaderWindow.astro'
import { Wordmark } from '@inlark/ui/components/wordmark'
import { AccountMark, MailRow } from './mail/MailRow'
import { accountById, accounts, inbox, type Conversation } from '../data/mail'

const unified = [inbox[0], inbox[2], inbox[3], inbox[5], inbox[4], inbox[6]].map((c) => ({
  ...c,
  unread: false,
}))

// What a search for old invoices turns up: the same sender, month after month.
const found: Conversation[] = ['September', 'August', 'July', 'June', 'May'].map((month, i) => ({
  ...inbox[6],
  id: 'invoice-' + month,
  subject: `Your invoice for ${month} is ready`,
  time: ['Sep 1', 'Aug 1', 'Jul 1', 'Jun 1', 'May 1'][i],
}))

const toasts = ['Archived 3 conversations', 'Moved to Receipts', 'Marked as spam']
const notifications = [
  { sender: inbox[0].sender, subject: inbox[0].subject, when: 'now' },
  { sender: inbox[1].sender, subject: inbox[1].subject, when: '29 min ago' },
]
---

<section id="features" class="wrap mt-28 sm:mt-44">
  <header class="reveal border-t border-line pt-12 sm:pt-16">
    <h2 class="statement">
      The complete everyday client.{' '}
      <span>
        Conversations, folders, search, attachments, drafts, replies and forwarding, with care in
        every detail.
      </span>
    </h2>
  </header>

  <div class="ledger mt-14 sm:mt-20">
    <!-- Unified inbox -->
    <div class="ledger-row">
      <article class="cell reveal lg:col-span-12">
        <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <h3 class="title">Every account, one calm inbox</h3>
            <p class="copy mt-2.5">
              Personal, work and side projects arrive together in one timeline, each marked with its
              account. Replies go out from the address the message was sent to.
            </p>
            <ul class="mt-9 border-t border-line text-[0.875rem]" aria-label="Example accounts">
              {accounts.map((a) => (
                <li class="flex items-center gap-3 border-b border-line py-2.5">
                  <AccountMark account={a} size={15} />
                  <span class="text-ink">{a.name}</span>
                  <span class="ml-auto truncate font-mono text-[0.72rem] text-ink-3">
                    {a.email}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <div class="app relative lg:col-span-8" aria-hidden="true">
            <div class="frame">
              <div class="app-main @container !rounded-[15px] !border-0">
                <div class="flex flex-wrap items-center gap-1.5 border-b border-(--border) px-4 py-3">
                  <span class="flex items-center gap-1.5 rounded-full bg-(--selected) px-2.5 py-1 text-[11.5px] text-(--text-strong)">
                    <Inbox size={13} /> All accounts
                  </span>
                  {accounts.map((a) => (
                    <span class="flex items-center gap-1.5 rounded-full border border-(--border-strong) px-2.5 py-1 text-[11.5px] text-(--secondary)">
                      <AccountMark account={a} size={12} /> {a.name}
                    </span>
                  ))}
                </div>
                {unified.map((c) => (
                  <MailRow conversation={c} />
                ))}
                <div class="h-10"></div>
              </div>
            </div>
            <div class="absolute right-4 -bottom-4 flex items-center gap-2 rounded-[9px] border border-(--border-strong) bg-(--raised) px-3 py-2 text-[11.5px] shadow-[0_18px_50px_var(--shadow)] sm:right-8">
              <span class="text-(--muted)">From</span>
              <AccountMark account={accountById.studio} size={14} />
              <span class="text-(--text-strong)">{accountById.studio.email}</span>
              <ChevronDown size={12} className="text-(--muted)" />
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- Command palette and search -->
    <div class="ledger-row">
      <article class="cell reveal lg:col-span-7">
        <h3 class="title">
          <kbd class="kbd mr-1 align-[0.08em]">Ctrl</kbd>
          <kbd class="kbd mr-1.5 align-[0.08em]">K</kbd> for everything
        </h3>
        <p class="copy mt-2.5 max-w-md">
          Every action, folder and account is a few letters away, with its shortcut beside it.
        </p>
        <div class="cell-visual app" aria-hidden="true">
          <div class="overflow-hidden rounded-[13px] border border-(--border-strong) bg-(--raised) shadow-[0_30px_70px_-20px_var(--shadow-deep)]">
            <div class="flex items-center gap-3 border-b border-(--border-strong) px-4 py-3.5 text-[13.5px]">
              <Search size={15} className="text-(--muted)" />
              <span class="text-(--text-strong)">
                arch<span class="caret"></span>
              </span>
              <span class="app-kbd ml-auto">Esc</span>
            </div>
            <div class="p-2 text-[12.5px]">
              <p class="px-2 pt-1.5 pb-1.5 text-[11px] text-(--muted)">Conversation</p>
              <p class="flex items-center gap-3 rounded-[8px] bg-(--selected) px-2 py-1.5 text-(--text-strong)">
                <span class="palette-icon text-(--accent)">
                  <Archive size={14} />
                </span>
                Archive <span class="app-kbd ml-auto">E</span>
              </p>
              <p class="px-2 pt-3 pb-1.5 text-[11px] text-(--muted)">Go to</p>
              <p class="flex items-center gap-3 px-2 py-1.5 text-(--secondary)">
                <span class="palette-icon">
                  <Archive size={14} />
                </span>
                Archive
                <span class="ml-auto flex gap-1">
                  <span class="app-kbd">G</span>
                  <span class="app-kbd">A</span>
                </span>
              </p>
              <p class="px-2 pt-3 pb-1.5 text-[11px] text-(--muted)">Mail</p>
              <p class="flex items-center gap-3 px-2 py-1.5 text-(--secondary)">
                <span class="palette-icon">
                  <Search size={14} />
                </span>
                Search all mail for “arch”
              </p>
            </div>
            <div class="flex items-center gap-2 border-t border-(--border) px-4 py-2.5 text-[11px] text-(--muted)">
              <span class="app-kbd">
                <ChevronUp size={11} />
              </span>
              <span class="app-kbd">
                <ChevronDown size={11} />
              </span>
              Navigate
              <span class="app-kbd ml-3">
                <CornerDownLeft size={10} />
              </span>
              Run
              <Wordmark height={11} className="ml-auto text-(--faint)" decorative />
            </div>
          </div>
        </div>
      </article>

      <article class="cell reveal lg:col-span-5" style="--delay:.08s">
        <h3 class="title">Search that goes all the way back</h3>
        <p class="copy mt-2.5">
          Search runs on your server across every folder and every year. Narrow it by sender,
          recipient, subject, date or attachment.
        </p>
        <div class="cell-visual app" aria-hidden="true">
          <div class="flex items-center gap-2.5 rounded-[9px] border border-(--accent-solid) bg-(--bg) px-3 py-2.5 text-[13px] shadow-[0_0_0_3px_color-mix(in_srgb,var(--accent-solid)_22%,transparent)]">
            <Search size={14} className="text-(--muted)" />
            <span class="text-(--text-strong)">invoice</span>
            <span class="app-kbd ml-auto !px-1.5">Enter</span>
          </div>
          <div class="mt-3 flex flex-wrap gap-1.5 text-[11.5px]">
            {['From: Northwind', 'After: 2024-01-01', 'Has attachments'].map((chip) => (
              <span class="flex items-center gap-1.5 rounded-md border border-(--border-strong) bg-(--surface) py-1 pr-1.5 pl-2 text-(--secondary)">
                {chip} <X size={11} className="text-(--muted)" />
              </span>
            ))}
          </div>
          <p class="mt-5 mb-2 text-[11.5px] text-(--muted)">
            <span class="text-(--text-strong)">31 conversations</span> · 2024 to today
          </p>
          <div class="fade-out @container overflow-hidden rounded-t-[10px] border border-b-0 border-(--border) bg-(--bg)">
            {found.map((c) => (
              <MailRow conversation={c} compact />
            ))}
          </div>
        </div>
      </article>
    </div>

    <!-- Themes -->
    <div class="ledger-row">
      <article class="cell reveal lg:col-span-12">
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
          <div class="max-w-md">
            <h3 class="title">Dark and light, with equal care</h3>
            <p class="copy mt-2.5">
              Quiet surfaces, readable type and subtle emphasis in both themes, or let inlark follow
              your desktop. Rich HTML mail keeps the look its sender designed.
            </p>
          </div>
          <p class="flex items-center gap-2.5 text-[0.8125rem] text-ink-3">
            <Moon size={14} />
            <span class="hint-rail" aria-hidden="true"></span>
            <Sun size={14} />
            <span class="ml-1 pointer-coarse:hidden">Move across the window to compare</span>
            <span class="ml-1 hidden pointer-coarse:inline">Drag to compare</span>
          </p>
        </div>

        <div class="compare frame mt-10" data-compare>
          <div class="compare-pane @container">
            <ReaderWindow theme="dark" />
          </div>
          <div class="compare-pane compare-light @container">
            <ReaderWindow theme="light" />
          </div>
          <svg
            class="compare-edge"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <line x1="52" y1="0" x2="48" y2="100" vector-effect="non-scaling-stroke"></line>
          </svg>
          <button
            type="button"
            class="compare-handle"
            data-compare-handle
            role="slider"
            aria-label="Compare the dark and light themes"
            aria-orientation="horizontal"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="50"
            aria-valuetext="Half dark, half light"
          >
            <Moon size={13} />
            <Sun size={13} />
          </button>
        </div>
      </article>
    </div>

    <!-- Undo, scale, desktop -->
    <div class="ledger-row">
      <article class="cell reveal lg:col-span-4">
        <h3 class="title">Every mistake, one key from undone</h3>
        <p class="copy mt-2.5">
          Archive, trash, move, star or mark as spam, then take it back with{' '}
          <kbd class="kbd align-[0.08em] text-[0.8rem]">Z</kbd>, even if another client changed the
          mailbox in between.
        </p>
        <div class="cell-visual app min-h-52" aria-hidden="true">
          {toasts.map((text, i) => (
            <div
              class="toast-stack absolute inset-x-0 flex items-center gap-3 rounded-[10px] border border-(--border-strong) bg-(--raised) py-2.5 pr-2.5 pl-4 text-[12.5px] text-(--text-strong) shadow-[0_18px_50px_var(--shadow)]"
              style={`top:${i * 56}px;opacity:${[1, 0.5, 0.22][i]};transform:scale(${1 - i * 0.04});z-index:${3 - i}`}
            >
              {text}
              <span class="ml-auto flex items-center gap-1.5 rounded-md px-2 py-1 text-(--accent)">
                <Undo2 size={13} /> Undo <span class="app-kbd">Z</span>
              </span>
            </div>
          ))}
        </div>
      </article>

      <article class="cell reveal lg:col-span-4" style="--delay:.08s">
        <h3 class="title">Built to feel instant</h3>
        <p class="copy mt-2.5">
          Archive, star or move, and the list changes the moment you press the key while the server
          catches up behind it. Conversations open from what’s already loaded, and long inboxes draw
          only the rows on screen.
        </p>
        <div class="cell-visual app min-h-52" aria-hidden="true">
          <div class="race rounded-[12px] border border-(--border-strong) bg-(--bg) p-[18px] shadow-[0_18px_50px_var(--shadow)]">
            <p class="flex items-center gap-2.5 text-[12.5px] text-(--text-strong)">
              <span class="race-key app-kbd">E</span> Archive
            </p>
            <div class="mt-5 grid grid-cols-[4.75rem_1fr] items-center gap-x-3 gap-y-4 text-[12px]">
              <span class="text-(--secondary)">inlark</span>
              <span class="race-line">
                <i class="race-bar race-instant" />
                <span class="race-done race-done-instant text-(--text-strong)">Archived</span>
              </span>

              <span class="text-(--muted)">Your server</span>
              <span class="race-line">
                <i class="race-bar race-slow" />
                <span class="race-done race-done-slow flex items-center gap-1 text-(--muted)">
                  <Check size={12} /> Saved
                </span>
              </span>

              <span></span>
              <span class="flex justify-between border-t border-(--border-strong) pt-2 text-[10.5px] text-(--faint)">
                <span>now</span>
                <span>a moment later</span>
              </span>
            </div>
          </div>
        </div>
      </article>

      <article class="cell reveal lg:col-span-4" style="--delay:.16s">
        <h3 class="title">At home on your desktop</h3>
        <p class="copy mt-2.5">
          Native notifications, a tray icon with your unread count, and every{' '}
          <span class="font-mono text-[0.86em] text-ink">mailto:</span> link opens a new message.
        </p>
        <div class="cell-visual app min-h-52" aria-hidden="true">
          <div class="flex items-center justify-end gap-3 rounded-[9px] border border-(--border) bg-black/40 px-3 py-1.5 text-[11px] text-(--secondary) light:bg-black/[0.03]">
            <span class="flex items-center gap-1.5">
              <Mark size={12} /> 9
            </span>
            <span>Mon 28 Sep</span>
            <span class="text-(--text-strong)">09:41</span>
          </div>
          {notifications.map((n, i) => (
            <div
              class="notification mt-2.5 flex gap-3 rounded-[14px] border border-(--border-strong) bg-(--raised) p-3.5 shadow-[0_24px_60px_var(--shadow)]"
              style={`opacity:${[1, 0.4][i]}`}
            >
              <span class="grid size-8 shrink-0 place-items-center rounded-[9px] scheme-dark bg-linear-to-br from-[#6268ef] to-[#292397]">
                <Mark size={16} />
              </span>
              <div class="min-w-0 text-[12px] leading-snug">
                <p class="flex gap-2 text-(--muted)">
                  inlark <span class="text-(--faint)">{n.when}</span>
                </p>
                <p class="mt-0.5 font-semibold text-(--text-strong)">{n.sender}</p>
                <p class="truncate text-(--secondary)">{n.subject}</p>
              </div>
            </div>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  // The theme comparison: the divide follows the pointer, a drag on touch screens, or the arrow keys.
  const compare = document.querySelector<HTMLElement>('[data-compare]')
  const handle = compare?.querySelector<HTMLElement>('[data-compare-handle]')
  if (compare && handle) {
    let position = 50
    const set = (value: number) => {
      position = Math.max(0, Math.min(100, value))
      compare.classList.add('is-touched')
      // The divide stops just short of each edge, so the handle never leaves the window.
      compare.style.setProperty('--x', Math.max(3, Math.min(97, position)) + '%')
      const light = Math.round(100 - position)
      handle.setAttribute('aria-valuenow', String(Math.round(position)))
      handle.setAttribute('aria-valuetext', `${100 - light}% dark, ${light}% light`)
    }
    const follow = (event: PointerEvent) => {
      const box = compare.getBoundingClientRect()
      set(((event.clientX - box.left) / box.width) * 100)
    }
    compare.addEventListener('pointerdown', follow)
    compare.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'mouse' || event.buttons) follow(event)
    })
    handle.addEventListener('keydown', (event) => {
      const step = { ArrowLeft: -5, ArrowDown: -5, ArrowRight: 5, ArrowUp: 5 }[event.key]
      if (step) set(position + step)
      else if (event.key === 'Home') set(0)
      else if (event.key === 'End') set(100)
      else return
      event.preventDefault()
    })
  }
</script>

<style>
  .caret {
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-left: 1px;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .palette-icon {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
  }

  /* Results run on past the edge of their cell. */
  .fade-out {
    mask-image: linear-gradient(180deg, #000 35%, transparent 96%);
  }

  /* Theme comparison */
  .compare {
    --x: 50%;
    height: clamp(420px, 46vw, 600px);
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
  }
  .compare-pane {
    position: absolute;
    inset: 1px;
    border-radius: 15px;
    overflow: hidden;
  }
  .compare-pane :global(.app) {
    height: 100%;
  }
  .compare-light {
    clip-path: polygon(calc(var(--x) + 2%) 0, 100% 0, 100% 100%, calc(var(--x) - 2%) 100%);
  }
  .compare-edge {
    position: absolute;
    inset: 1px;
    left: calc(var(--x) - 50%);
    width: 100%;
    height: calc(100% - 2px);
    pointer-events: none;
    overflow: visible;
  }
  .compare-edge line {
    stroke: rgb(255 255 255 / 0.5);
    stroke-width: 1;
  }
  .compare-handle {
    position: absolute;
    left: var(--x);
    top: 50%;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    height: 2rem;
    padding: 0 0.6rem;
    translate: -50% -50%;
    border-radius: 999px;
    color: #17171a;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(20 20 30 / 0.12),
      0 8px 24px -6px rgb(0 0 0 / 0.5);
    cursor: ew-resize;
  }
  /* On first sight the divide sweeps in from the right, which shows it can move. */
  :global(.is-visible) .compare:not(.is-touched) {
    animation: compare-sweep 1.8s var(--ease-out-expo) 0.3s backwards;
  }
  @keyframes compare-sweep {
    from {
      --x: 88%;
    }
  }

  .hint-rail {
    width: 2.25rem;
    height: 1px;
    background: var(--color-line-strong);
  }

  .toast-stack {
    transform-origin: 50% 0;
  }

  /* One keystroke, two finishes, on a shared time line: the app is done at once and the server
     in its own time. The resting state is the finished race, which is what reduced motion shows. */
  .race-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .race-bar {
    display: block;
    height: 3px;
    border-radius: 3px;
    transform-origin: 0 50%;
  }
  .race-instant {
    width: 6px;
    height: 6px;
    background: var(--accent);
    animation: race-instant 6s linear infinite;
  }
  .race-slow {
    flex: 1;
    background: color-mix(in srgb, var(--muted) 55%, transparent);
    animation: race-slow 6s linear infinite;
  }
  .race-key {
    animation: race-key 6s linear infinite;
  }
  .race-done-instant {
    animation: race-done-instant 6s linear infinite;
  }
  .race-done-slow {
    animation: race-done-slow 6s linear infinite;
  }
  @keyframes race-key {
    0%,
    7%,
    13%,
    100% {
      transform: none;
      color: var(--muted);
      border-color: var(--border-strong);
    }
    8%,
    11% {
      transform: translateY(1px);
      color: var(--text-strong);
      border-color: var(--accent);
    }
  }
  @keyframes race-instant {
    0%,
    8% {
      transform: scale(0);
      opacity: 1;
    }
    10%,
    90% {
      transform: none;
      opacity: 1;
    }
    97%,
    100% {
      transform: none;
      opacity: 0;
    }
  }
  @keyframes race-done-instant {
    0%,
    9.5% {
      opacity: 0;
    }
    10.5%,
    90% {
      opacity: 1;
    }
    97%,
    100% {
      opacity: 0;
    }
  }
  @keyframes race-slow {
    0%,
    10% {
      transform: scaleX(0);
      opacity: 1;
      animation-timing-function: cubic-bezier(0.3, 0.6, 0.4, 1);
    }
    42%,
    90% {
      transform: none;
      opacity: 1;
    }
    97%,
    100% {
      transform: none;
      opacity: 0;
    }
  }
  @keyframes race-done-slow {
    0%,
    42% {
      opacity: 0;
    }
    45%,
    90% {
      opacity: 1;
    }
    97%,
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .race-bar,
    .race-key,
    .race-done {
      animation: none;
    }
  }
</style>
