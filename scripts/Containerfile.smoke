FROM docker.io/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates xvfb xauth libgtk-3-0 libnss3 libasound2 libgbm1 libxss1 libxtst6 libdrm2 libxkbcommon0 libsecret-1-0 libnotify4 xdg-utils libatspi2.0-0 && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home app
USER app
ENV INLARK_DATA_DIR=/tmp/inlark-smoke
# Nested Chromium namespaces are unavailable in many rootless container hosts.
# Only this isolated, network-disabled packaging smoke uses --no-sandbox.
CMD ["sh", "-c", "dpkg-deb -x /release/Inlark-0.1.0-amd64.deb /tmp/package && xvfb-run -a /tmp/package/opt/Inlark/inlark --smoke-test --no-sandbox --disable-gpu"]
